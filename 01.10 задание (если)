numbers = [1, 2, 3, 4, 5, 10, 19, 25, 88, 100]

total = 0

for num in numbers:
    if num % 5 == 0:          # проверяем делится ли число на 5 без остатка
        total += num           # если да — прибавляем к сумме
    else:
        print(f"{num} не делится на 5, пропускаем")

print(f"Сумма чисел, делящихся на 5: {total}")
